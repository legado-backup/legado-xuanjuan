<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="@color/xuanjuan_read_aloud_gold_dim" />
            <stroke android:width="2dp" android:color="@color/xuanjuan_read_aloud_gold" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="@color/xuanjuan_read_aloud_gold_dim" />
            <stroke android:width="1dp" android:color="@color/xuanjuan_read_aloud_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="@color/xuanjuan_read_aloud_card_high" />
            <stroke android:width="1dp" android:color="@color/xuanjuan_read_aloud_stroke" />
        </shape>
    </item>
</selector>
