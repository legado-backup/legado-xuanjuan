<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/xuanjuan_read_aloud_bg"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tv_console_title"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:text="@string/read_aloud_console_title"
        android:textColor="@color/xuanjuan_read_aloud_gold"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/ll_engine"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/xuanjuan_read_aloud_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_engine"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_volume_up"
            app:tint="@color/xuanjuan_read_aloud_gold" />

        <TextView
            android:id="@+id/tv_engine_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/speak_engine"
            android:textColor="@color/xuanjuan_read_aloud_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_engine_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:singleLine="true"
            android:textColor="@color/xuanjuan_read_aloud_text_secondary"
            android:textSize="13sp"
            tools:text="绯荤粺榛樿" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_engine_arrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:rotation="-90"
            android:src="@drawable/ic_arrow_drop_down"
            app:tint="@color/xuanjuan_read_aloud_gold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_pre"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:singleLine="true"
            android:text="@string/previous_chapter"
            android:textColor="@color/xuanjuan_read_aloud_text_secondary"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/iv_play_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/prev_sentence"
            android:padding="12dp"
            android:src="@drawable/ic_skip_previous"
            android:tooltipText="@string/prev_sentence"
            app:tint="@color/xuanjuan_read_aloud_gold"
            tools:ignore="UnusedAttribute" />

        <ImageView
            android:id="@+id/iv_play_pause"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/xuanjuan_read_aloud_action_bg"
            android:contentDescription="@string/audio_play"
            android:padding="16dp"
            android:src="@drawable/ic_play_24dp"
            android:tooltipText="@string/audio_play"
            app:tint="@color/xuanjuan_read_aloud_action_icon"
            tools:ignore="UnusedAttribute" />

        <ImageView
            android:id="@+id/iv_stop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/stop"
            android:padding="12dp"
            android:src="@drawable/ic_stop_black_24dp"
            android:tooltipText="@string/stop"
            app:tint="@color/xuanjuan_read_aloud_text_secondary"
            tools:ignore="UnusedAttribute" />

        <ImageView
            android:id="@+id/iv_play_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next_sentence"
            android:padding="12dp"
            android:src="@drawable/ic_skip_next"
            android:tooltipText="@string/next_sentence"
            app:tint="@color/xuanjuan_read_aloud_gold"
            tools:ignore="UnusedAttribute" />

        <TextView
            android:id="@+id/tv_next"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:singleLine="true"
            android:text="@string/next_chapter"
            android:textColor="@color/xuanjuan_read_aloud_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_timer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/xuanjuan_read_aloud_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_timer"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_time_add_24dp"
            app:tint="@color/xuanjuan_read_aloud_gold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_timer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_timer_title"
                android:textColor="@color/xuanjuan_read_aloud_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/sleep_timer_status_none"
                android:textColor="@color/xuanjuan_read_aloud_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:rotation="-90"
            android:src="@drawable/ic_arrow_drop_down"
            app:tint="@color/xuanjuan_read_aloud_gold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_speed_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/xuanjuan_read_aloud_card"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/ll_tts_SpeechRate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/tv_tts_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/read_aloud_speed"
                android:textColor="@color/xuanjuan_read_aloud_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_tts_speed_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/xuanjuan_read_aloud_gold"
                android:textSize="14sp"
                tools:text="1.0脳" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <io.legado.app.lib.theme.view.ThemeSwitch
                android:id="@+id/cb_tts_follow_sys"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/flow_sys"
                android:text="@string/flow_sys"
                android:textColor="@color/xuanjuan_read_aloud_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_tts_speech_reduce"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tts_speech_reduce"
                android:padding="12dp"
                android:src="@drawable/ic_reduce"
                android:tooltipText="@string/tts_speech_reduce"
                app:tint="@color/xuanjuan_read_aloud_gold"
                tools:ignore="UnusedAttribute" />

            <io.legado.app.lib.theme.view.ThemeSeekBar
                android:id="@+id/seek_tts_speechRate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="45" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_tts_speech_add"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tts_speech_add"
                android:padding="12dp"
                android:src="@drawable/ic_add"
                android:tooltipText="@string/tts_speech_add"
                app:tint="@color/xuanjuan_read_aloud_gold"
                tools:ignore="UnusedAttribute" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_speed_08"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/selector_read_aloud_speed"
                android:gravity="center"
                android:text="@string/tts_speed_08x"
                android:textColor="@color/xuanjuan_read_aloud_text_primary" />

            <TextView
                android:id="@+id/tv_speed_10"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/selector_read_aloud_speed"
                android:gravity="center"
                android:text="@string/tts_speed_10x"
                android:textColor="@color/xuanjuan_read_aloud_text_primary" />

            <TextView
                android:id="@+id/tv_speed_12"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/selector_read_aloud_speed"
                android:gravity="center"
                android:text="@string/tts_speed_12x"
                android:textColor="@color/xuanjuan_read_aloud_text_primary" />

            <TextView
                android:id="@+id/tv_speed_15"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/selector_read_aloud_speed"
                android:gravity="center"
                android:text="@string/tts_speed_15x"
                android:textColor="@color/xuanjuan_read_aloud_text_primary" />

            <TextView
                android:id="@+id/tv_speed_20"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/selector_read_aloud_speed"
                android:gravity="center"
                android:text="@string/tts_speed_20x"
                android:textColor="@color/xuanjuan_read_aloud_text_primary" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_back_to_speech"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/xuanjuan_read_aloud_card"
        android:clickable="true"
        android:contentDescription="@string/back_to_speaking_position"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_volume_up"
            app:tint="@color/xuanjuan_read_aloud_gold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/back_to_speaking_position"
            android:textColor="@color/xuanjuan_read_aloud_text_primary"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:rotation="-90"
            android:src="@drawable/ic_arrow_drop_down"
            app:tint="@color/xuanjuan_read_aloud_gold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/ll_catalog"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/chapter_list"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_catalog"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/chapter_list"
                android:src="@drawable/ic_toc"
                app:tint="@color/xuanjuan_read_aloud_gold" />

            <TextView
                android:id="@+id/tv_catalog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/chapter_list"
                android:textColor="@color/xuanjuan_read_aloud_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_main_menu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/main_menu"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_main_menu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/main_menu"
                android:src="@drawable/ic_menu"
                app:tint="@color/xuanjuan_read_aloud_gold" />

            <TextView
                android:id="@+id/tv_main_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/main_menu"
                android:textColor="@color/xuanjuan_read_aloud_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_to_backstage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/to_backstage"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_to_backstage"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/to_backstage"
                android:src="@drawable/ic_visibility_off"
                app:tint="@color/xuanjuan_read_aloud_gold" />

            <TextView
                android:id="@+id/tv_to_backstage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/to_backstage"
                android:textColor="@color/xuanjuan_read_aloud_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_setting"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/setting"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_setting"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/setting"
                android:src="@drawable/ic_settings"
                app:tint="@color/xuanjuan_read_aloud_gold" />

            <TextView
                android:id="@+id/tv_setting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/setting"
                android:textColor="@color/xuanjuan_read_aloud_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

