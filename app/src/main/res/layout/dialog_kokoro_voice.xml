<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/xuanjuan_read_aloud_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/kokoro_voice_title"
            android:textColor="@color/xuanjuan_read_aloud_text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/kokoro_voice_summary"
            android:textColor="@color/xuanjuan_read_aloud_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_role_narrator"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/selector_read_aloud_speed"
                android:gravity="center"
                android:text="@string/kokoro_role_narrator"
                android:textColor="@color/xuanjuan_read_aloud_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_role_male"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/selector_read_aloud_speed"
                android:gravity="center"
                android:text="@string/kokoro_role_male"
                android:textColor="@color/xuanjuan_read_aloud_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_role_female"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/selector_read_aloud_speed"
                android:gravity="center"
                android:text="@string/kokoro_role_female"
                android:textColor="@color/xuanjuan_read_aloud_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_role_unknown"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/selector_read_aloud_speed"
                android:gravity="center"
                android:text="@string/kokoro_role_unknown"
                android:textColor="@color/xuanjuan_read_aloud_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/xuanjuan_read_aloud_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_current_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/xuanjuan_read_aloud_gold"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_preset_1"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/selector_read_aloud_speed"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/xuanjuan_read_aloud_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_preset_2"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/selector_read_aloud_speed"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/xuanjuan_read_aloud_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_preset_3"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/selector_read_aloud_speed"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/xuanjuan_read_aloud_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_preset_4"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/selector_read_aloud_speed"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/xuanjuan_read_aloud_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_preview"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/xuanjuan_read_aloud_action_bg"
                android:gravity="center"
                android:minHeight="48dp"
                android:text="@string/kokoro_voice_preview"
                android:textColor="@color/xuanjuan_read_aloud_action_icon"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/xuanjuan_read_aloud_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_advanced_toggle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="@string/kokoro_voice_advanced_expand"
                android:textColor="@color/xuanjuan_read_aloud_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ll_advanced_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_advanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/xuanjuan_read_aloud_gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/kokoro_voice_advanced_summary"
                    android:textColor="@color/xuanjuan_read_aloud_text_secondary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_advanced"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:progressTint="@color/xuanjuan_read_aloud_gold"
                    android:thumbTint="@color/xuanjuan_read_aloud_gold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_character_voices"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/xuanjuan_read_aloud_card"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/kokoro_character_voice_entry"
            android:textColor="@color/xuanjuan_read_aloud_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_cancel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/selector_read_aloud_speed"
                android:gravity="center"
                android:minHeight="48dp"
                android:text="@string/cancel"
                android:textColor="@color/xuanjuan_read_aloud_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_save"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/xuanjuan_read_aloud_action_bg"
                android:gravity="center"
                android:minHeight="48dp"
                android:text="@string/action_save"
                android:textColor="@color/xuanjuan_read_aloud_action_icon"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
